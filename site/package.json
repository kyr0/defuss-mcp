{
  "name": "defuss-mcp-site",
  "version": "0.6.2",
  "description": "Project website for defuss-mcp: a live in-browser MCP demo, the client matrix and measured performance.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Aron Homberg",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "vite",
