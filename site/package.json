  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/node": "24.10.0",
    "oxlint": "1.94.0",
    "playwright": "1.62.1",
    "shiki": "4.6.0",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "defuss-shadcn": "0.9.12"
  }
}
