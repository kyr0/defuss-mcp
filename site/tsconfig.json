{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "defuss-mcp": ["../dist/index.d.mts"],
      "defuss-mcp/*": ["../dist/*.d.mts"]
    }
  },
  "include": ["src", "build", "test", "e2e", "vite.config.ts"]
}
